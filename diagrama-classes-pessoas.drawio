        <mxCell id="nota" value="&lt;b&gt;Regras&lt;/b&gt;&lt;br&gt;Somente Cliente e Funcionario podem ser Usuario.&lt;br&gt;CLIENTE possui acesso somente como cliente.&lt;br&gt;Funcionários podem ter perfis de acesso diferentes.&lt;br&gt;Pessoa não possui atributo endereco; a obrigatoriedade é a composição Pessoa 1..1 Endereco.&lt;br&gt;Cliente PJ possui CNPJ como String." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="700" width="300" height="190" as="geometry"/></mxCell>
